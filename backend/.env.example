# ─────────────────────────────────────────────────────────────
# BridgeX Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── JWT Authentication ────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-random-secret-key-minimum-32-chars

# JWT algorithm (do not change unless you know what you're doing)
ALGORITHM=HS256

# Token expiry in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ──────────────────────────────────────────────────
# Local SQLite (default — no setup needed for development):
# DATABASE_URL=sqlite:///./bridgex.db

# PostgreSQL / Supabase production:
DATABASE_URL=postgresql://username:password@host:5432/bridgex_db

# ── File Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760

# ── SLA Escalation ────────────────────────────────────────────
# Number of hours before an unanswered doubt is auto-escalated
ESCALATION_HOURS_THRESHOLD=48

# ── CORS Settings ─────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (or * in development):
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
