# ─────────────────────────────────────────────
# BridgeX — Professional .gitignore
# React + Vite + TypeScript + Python + FastAPI
# ─────────────────────────────────────────────

# ── Node / Frontend ──────────────────────────
node_modules/
dist/
dist-ssr/
build/
.cache/
*.local

# Vite
vite.config.ts.timestamp-*

# ── Python / Backend ─────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Distribution / Packaging
.eggs/
*.egg-info/
*.egg
MANIFEST

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Type checking
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
pyrightconfig.json

# ── Database ─────────────────────────────────
# SQLite local dev database — reproducible via seed_data.py
*.db
*.sqlite
*.sqlite3

# ── Uploads (runtime generated) ──────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── Environment & Secrets ────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production
.env.production.local
*.env

# ── OS & Editor ──────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V500
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Build artifacts ───────────────────────────
*.tsbuildinfo

# ── Misc ─────────────────────────────────────
.vercel
.netlify
.turbo
